{
    "name": "karate-attendance-backend",
    "version": "1.0.0",
    "description": "TypeScript Express.js backend for karate school attendance management",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
        "dev:frontend": "cd frontend && export $(grep -v '^#' .env.local | xargs) && pnpm run dev",
        "dev:all": "pnpm run dev & pnpm run dev:frontend",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "test": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" jest",
        "verify": "pnpm test && pnpm run build && pnpm -C frontend run build",
        "lint:frontend": "cd frontend && npx eslint . --ext .ts,.tsx,.js,.jsx || true",
        "lint:backend": "npx eslint \"src/**/*.{ts,tsx,js,jsx}\" --ext .ts,.tsx,.js,.jsx || true",
        "lint": "pnpm run lint:frontend && pnpm run lint:backend",
        "seed:admin": "ts-node -r tsconfig-paths/register src/scripts/seedAdmin.ts",
        "migrate:categories-sv": "ts-node -r tsconfig-paths/register src/scripts/migrateCategoriesToSwedish.ts"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.20",
        "@fullcalendar/daygrid": "^6.1.20",
        "@fullcalendar/timegrid": "^6.1.20",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "5.2.1",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "joi": "^18.0.2",
        "js-yaml": "^4.1.1",
        "jsonwebtoken": "^9.0.3",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.1",
        "mongoose": "^9.1.2",
        "prom-client": "^15.1.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/cors": "^2.8.19",
        "@types/express": "5.0.6",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongodb": "^4.0.7",
        "@types/node": "^22.10.5",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.3.0",
        "mongodb-memory-server": "^11.0.1",
        "ts-jest": "^29.4.6",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}
