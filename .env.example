# ==============================================================================
# Backend Environment Configuration
# ==============================================================================
# NOTE: This file is used by the backend server (Express.js)
# Frontend-specific variables are in frontend/.env.local
# IMPORTANT: Keep FRONTEND_URL and PORT in sync with frontend/.env.local values
# ==============================================================================

# MongoDB Configuration
# Tip: match credentials with docker-compose.yml when using Docker
MONGODB_URI=mongodb://<user>:<password>@localhost:27019/attendance?authSource=admin

# Docker Compose MongoDB init credentials (used by docker-compose.yml)
MONGO_INITDB_ROOT_USERNAME=<user>
MONGO_INITDB_ROOT_PASSWORD=<password>
MONGO_INITDB_DATABASE=attendance

# Backend API Configuration
PORT=4000
NODE_ENV=development

# Frontend CORS Configuration
# Must match NEXTAUTH_URL in frontend/.env.local
FRONTEND_URL=http://localhost:4001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Optional seed-admin overrides. Do not use the default password in production.
SEED_ADMIN_EMAIL=admin@karateattendance.com
SEED_ADMIN_PASSWORD=ChangeMe123!
