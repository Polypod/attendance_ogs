# ==============================================================================
# Backend Environment Configuration - PRODUCTION
# ==============================================================================
# NOTE: This file is used by the backend server (Express.js) in production
# Used by start-prod.sh script
# ==============================================================================

# MongoDB Configuration
MONGODB_URI=mongodb://root:ogsadmin@localhost:27019/attendance?authSource=admin

# Docker Compose MongoDB init credentials (used by docker-compose.yml)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=ogsadmin
MONGO_INITDB_DATABASE=attendance

# Backend API Configuration
PORT=4010
NODE_ENV=production

# Frontend CORS Configuration
# Must match NEXTAUTH_URL in frontend/.env.production.local
FRONTEND_URL=https://att.minamail.se

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10
